# Copy to .env and fill in. Never commit .env.

# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Used for creating logins, Storage, and the seed script. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for projects still on the legacy HS256 JWT secret. Leave empty to verify
# tokens with the project's published signing keys (JWKS).
SUPABASE_JWT_SECRET=
# Private Storage bucket for envelope photos (created by backend/migrations/001_init.sql)
STORAGE_BUCKET=

# Anthropic API (image pipeline)
ANTHROPIC_API_KEY=
PIPELINE_MODEL=

# Logins are username + password. Supabase Auth needs an email per account, so the backend
# stores each username as <username>@AUTH_EMAIL_DOMAIN. Nothing is ever sent to it.
AUTH_EMAIL_DOMAIN=

# SMS: "simulated" (default, writes to followup_log only) or "twilio" (not implemented yet)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Seed script passwords for the demo logins (default to staff123 / dorothy123 if empty)
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=
